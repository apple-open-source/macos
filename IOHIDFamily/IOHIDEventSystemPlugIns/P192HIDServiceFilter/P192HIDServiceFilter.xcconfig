SUPPORTED_PLATFORMS = xros
PRODUCT_NAME = P192HIDServiceFilter
PRODUCT_BUNDLE_IDENTIFIER = com.apple.$(PRODUCT_NAME)
PRODUCT_MODULE_NAME = $(PRODUCT_NAME:c99extidentifier)

INSTALL_PATH = $(SYSTEM_LIBRARY_DIR)/HIDPlugins/ServiceFilters

WRAPPER_EXTENSION = plugin

SWIFT_VERSION = 6.0

INFOPLIST_FILE = IOHIDEventSystemPlugIns/P192HIDServiceFilter/Info.plist

INSTALLHDRS_SCRIPT_PHASE = YES

INSTALLHDRS_COPY_PHASE = YES

AD_HOC_CODE_SIGNING_ALLOWED = YES
