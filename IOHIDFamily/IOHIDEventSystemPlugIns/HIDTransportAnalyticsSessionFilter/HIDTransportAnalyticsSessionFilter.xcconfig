
SUPPORTED_PLATFORMS = macosx iphoneos tvos watchos
PRODUCT_BUNDLE_IDENTIFIER = com.apple.HIDTransportAnalyticsSessionFilter
PRODUCT_MODULE_NAME = $(PRODUCT_NAME:c99extidentifier)
PRODUCT_NAME = HIDTransportAnalyticsSessionFilter

INSTALL_PATH = /usr/appleinternal/lib/HIDPlugins/SessionFilters

WRAPPER_EXTENSION = plugin

SWIFT_VERSION = 6.0

INFOPLIST_FILE = IOHIDEventSystemPlugIns/HIDTransportAnalyticsSessionFilter/Info.plist

INSTALLHDRS_SCRIPT_PHASE = YES

INSTALLHDRS_COPY_PHASE = YES

AD_HOC_CODE_SIGNING_ALLOWED = YES
