<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IgnoreOutput</key>
	<true/>
	<key>Project</key>
	<string>ksh</string>
	<key>TestSpecificLogs</key>
	<array>
	   <string>BATS_TMP_DIR/.*results.txt</string>
	</array>
	<key>Tests</key>
	<array>
		<dict>
			<key>TestName</key>
			<string>ksh.ksh_test.sh.search_path</string>
			<key>ShellEnv</key>
			<dict>
				<key>ATF_SH</key>
				<string>/usr/local/bin/atf-sh</string>
				<key>__RUNNING_INSIDE_ATF_RUN</key>
				<string>internal-yes-value</string>
			</dict>
			<key>Command</key>
			<array>
				<string>/usr/local/bin/atf-sh</string>
				<string>/AppleInternal/Tests/ksh/ksh/ksh_test.sh</string>
				<string>-s</string>
				<string>/AppleInternal/Tests/ksh/ksh</string>
				<string>-r</string>
				<string>ksh_test.sh.search_path.results.txt</string>
				<string>search_path</string>
			</array>
			<key>Description</key>
			<string>Verify that ksh can search PATH</string>
			<key>MayRunConcurrently</key>
			<true/>
			<key>Timeout</key>
			<integer>300</integer>
		</dict>
		<dict>
			<key>TestName</key>
			<string>ksh.ksh_test.sh.builtin_test_d</string>
			<key>ShellEnv</key>
			<dict>
				<key>ATF_SH</key>
				<string>/usr/local/bin/atf-sh</string>
				<key>__RUNNING_INSIDE_ATF_RUN</key>
				<string>internal-yes-value</string>
			</dict>
			<key>Command</key>
			<array>
				<string>/usr/local/bin/atf-sh</string>
				<string>/AppleInternal/Tests/ksh/ksh/ksh_test.sh</string>
				<string>-s</string>
				<string>/AppleInternal/Tests/ksh/ksh</string>
				<string>-r</string>
				<string>ksh_test.sh.builtin_test_d.results.txt</string>
				<string>builtin_test_d</string>
			</array>
			<key>Description</key>
			<string>Verify that builtin test -d works</string>
			<key>MayRunConcurrently</key>
			<true/>
			<key>Timeout</key>
			<integer>300</integer>
		</dict>
		<dict>
			<key>TestName</key>
			<string>ksh.ksh_test.sh.builtin_test_f</string>
			<key>ShellEnv</key>
			<dict>
				<key>ATF_SH</key>
				<string>/usr/local/bin/atf-sh</string>
				<key>__RUNNING_INSIDE_ATF_RUN</key>
				<string>internal-yes-value</string>
			</dict>
			<key>Command</key>
			<array>
				<string>/usr/local/bin/atf-sh</string>
				<string>/AppleInternal/Tests/ksh/ksh/ksh_test.sh</string>
				<string>-s</string>
				<string>/AppleInternal/Tests/ksh/ksh</string>
				<string>-r</string>
				<string>ksh_test.sh.builtin_test_f.results.txt</string>
				<string>builtin_test_f</string>
			</array>
			<key>Description</key>
			<string>Verify that builtin test -f works</string>
			<key>MayRunConcurrently</key>
			<true/>
			<key>Timeout</key>
			<integer>300</integer>
		</dict>
	</array>
</dict>
</plist>
